{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.strivis.app" }],
      "destination": "https://strivis.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.strivis.app" }],
      "destination": "https://strivis.app/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://connect.facebook.net; style-src 'self'; img-src 'self' data: https://www.facebook.com; font-src 'self' data:; connect-src 'self' https://strivis-backend-production.up.railway.app https://www.facebook.com https://connect.facebook.net; frame-src https://www.facebook.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        { "key": "Access-Control-Allow-Origin", "value": "https://strivis.app" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/oauth-native-callback",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/u/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/newsletter/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/p/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/(sw|service-worker).js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/support", "destination": "/support/index.html" },
    { "source": "/datenschutz", "destination": "/datenschutz/index.html" },
    { "source": "/agb", "destination": "/agb/index.html" },
    { "source": "/impressum", "destination": "/impressum/index.html" },
    { "source": "/copyright", "destination": "/copyright/index.html" },
    { "source": "/de", "destination": "/de/index.html" },
    { "source": "/de/support", "destination": "/de/support/index.html" },
    { "source": "/links", "destination": "/links/index.html" },
    { "source": "/de/links", "destination": "/de/links/index.html" },
    { "source": "/u/(.*)", "destination": "/app-shell.html" },
    { "source": "/p/(.*)", "destination": "/app-shell.html" },
    { "source": "/oauth-native-callback", "destination": "/app-shell.html" },
    { "source": "/newsletter/(.*)", "destination": "/app-shell.html" }
  ]
}
